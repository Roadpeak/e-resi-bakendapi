generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  BUYER
  INVESTOR
  TENANT
  DEVELOPER
  AGENT
  ADMIN
}

/// An agent is either a registered company or a sole practitioner. The two
/// verify differently — a company submits registration documents, an
/// individual a national ID and a passport photo — and they are billed and
/// listed separately, so the distinction is modelled rather than inferred.
enum AgentKind {
  COMPANY
  INDIVIDUAL
}

/// What an agent actually handles. Selected at signup and used to filter the
/// "Need agent help?" picker on the browse pages, so a tenant looking for a
/// rental is never shown an agent who only does commercial sales.
enum AgentSpecialty {
  APARTMENT_RENTAL
  APARTMENT_PURCHASE
  VILLA_RENTAL
  VILLA_PURCHASE
  COMMERCIAL_RENTAL
  COMMERCIAL_PURCHASE
  LAND_SALE
}

enum KybStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  OFF_PLAN
  SOLD_OUT
  ARCHIVED
}

enum PropertyCategory {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  OFFICE
  COMMERCIAL
  LAND
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum FurnishingType {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum RentListingStatus {
  AVAILABLE
  PARTIALLY_AVAILABLE
  FULLY_LET
  ARCHIVED
}

enum MediaType {
  PHOTO
  VIDEO
  DRONE_PHOTO
  DRONE_VIDEO
  FLOOR_PLAN
  VIRTUAL_TOUR
  THREE_D_MODEL
}

enum CinematicSceneCategory {
  FULL_TOUR
  AERIAL
  EXTERIOR
  LIVING_ROOM
  KITCHEN
  BEDROOM
  BATHROOM
  AMENITIES
  UNIT_TYPE
}

enum TourCameraPreset {
  AERIAL
  STREET
  ROOFTOP
  INTERIOR
  LOBBY
  POOL
  GYM
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum BookingType {
  PHYSICAL
  VIRTUAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReservationStage {
  RESERVED
  AGREEMENT_SIGNED
  DEPOSIT_PAID
  FINAL_PAYMENT
  TITLE_TRANSFERRED
  CANCELLED
}

enum NotificationType {
  /// Platform-wide message sent by an administrator.
  SYSTEM_ANNOUNCEMENT
  INQUIRY_RECEIVED
  INQUIRY_REPLIED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  RESERVATION_UPDATED
  RESERVATION_EXPIRING
  PAYMENT_RECEIVED
  /// An invoice was issued and is awaiting payment.
  INVOICE_ISSUED
  /// A due or overdue invoice is being chased.
  INVOICE_REMINDER
  /// Payment settled — receipt available.
  RECEIPT_ISSUED
  /// A card was linked, or its verification charge reversed.
  PAYMENT_METHOD_UPDATED
  KYB_APPROVED
  KYB_REJECTED
  PROPERTY_PUBLISHED
  GENERAL
}

enum PaymentMethod {
  STRIPE_CARD
  MPESA
  PAYPAL
  PAYSTACK_CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProductionOrderStatus {
  ORDERED
  SCHEDULED
  IN_PRODUCTION
  DELIVERED
  CANCELLED
}

enum ProductionTierType {
  LISTING_ONLY
  PHOTOGRAPHY
  PHOTOGRAPHY_VIDEO
  TOUR_CINEMATIC
  TOUR_3D
  TOUR_VR
  FULL_PRODUCTION
}

enum AmenityType {
  SCHOOL
  HOSPITAL
  MALL
  TRANSPORT
  RESTAURANT
  PARK
  BANK
  AIRPORT
  GYM
  SUPERMARKET
  HOTEL
}

enum AnalyticsEventType {
  PAGE_VIEW
  TOUR_START
  TOUR_COMPLETE
  INQUIRY_SUBMITTED
  BOOKING_SUBMITTED
  UNIT_VIEWED
  PROPERTY_SAVED
  SHARE
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  role            UserRole  @default(BUYER)
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  isActive        Boolean   @default(true)
  /// Why and when access was withdrawn — a bare boolean loses the reason.
  suspendedAt     DateTime?
  suspendedReason String?
  oauthProvider        String?
  oauthId              String?
  refreshToken         String?
  emailVerifyToken     String?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  developerProfile  DeveloperProfile?
  agentProfile      AgentProfile?
  agentReviews      AgentReview[]
  partnershipRequests   AgentPartnership[]    @relation("PartnershipRequester")
  partnershipDocuments  PartnershipDocument[] @relation("PartnershipDocUploader")
  savedProperties   SavedProperty[]
  inquiries         Inquiry[]
  inquiryReplies    InquiryReply[]
  bookings          Booking[]
  reservations      Reservation[]
  notifications     Notification[]
  analyticsEvents   AnalyticsEvent[]
  payments          Payment[]
  documents         Document[]
  paymentMethods    LinkedPaymentMethod[]
  conversationsStarted Conversation[] @relation("ConversationInitiator")
  conversationsReceived Conversation[] @relation("ConversationCounterparty")
  chatMessages      ChatMessage[]
  auditLogs         AuditLog[]     @relation("AuditActor")
  invoices          Invoice[]
  receipts          Receipt[]

  @@index([email])
  @@index([role])
}

enum LinkedMethodType {
  CARD
  PAYPAL
  MPESA
}

enum MethodVerification {
  PENDING
  VERIFIED
  FAILED
}

/// A payment method the user has linked for billing. Card data is never
/// stored in full — only brand, last4 and expiry for display; charging
/// happens through the processor once payments go live.
model LinkedPaymentMethod {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              LinkedMethodType
  // card display metadata — the PAN and CVC are never persisted
  brand             String?
  last4             String?
  expMonth          Int?
  expYear           Int?
  cardholderName    String?
  // billing address (Google Payments style)
  addressLine1      String?
  addressLine2      String?
  city              String?
  postalCode        String?
  country           String?
  // paypal billing agreement (vault for automatic monthly billing)
  paypalEmail       String?
  paypalAgreementId String?
  // m-pesa
  mpesaPhone        String?
  // processor references (stripe customer / payment method etc.)
  processorRef      String?
  verification      MethodVerification @default(PENDING)
  verifiedAt        DateTime?
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// DEVELOPER PROFILE
// ─────────────────────────────────────────────

model DeveloperProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  logoUrl           String?
  description       String?
  establishedYear   Int?
  completedProjects Int       @default(0)
  website           String?
  kybStatus         KybStatus @default(NOT_SUBMITTED)
  kybDocuments      Json?
  kybReviewedAt     DateTime?
  kybReviewedBy     String?
  onboarding        Json?
  onboardingSubmittedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// Public contact — shown on the developer's card and profile page.
  /// Separate from User.phone, which is the account owner's private login contact.
  phone             String?
  /// Full wa.me-ready number (digits only, no +), so the WhatsApp icon can
  /// deep-link straight into a chat without any client-side reformatting.
  whatsapp          String?
  /// Free-text city/area shown on the card — e.g. "Nairobi, Westlands".
  /// Not FK'd to any location table; developers operate across areas, not one.
  location          String?
  /// { instagram?, facebook?, twitter?, linkedin?, tiktok?: string } — full
  /// profile URLs. Optional keys throughout; the profile page renders only
  /// whichever are present rather than a fixed set of icons.
  socials           Json?

  // ─── Mini-site brand defaults ────────────────────────────────────────────
  //
  // Set once here and every development inherits them, so a developer with
  // ten projects brands them all in one place. A development may still
  // override any of these — see the matching fields on Property.

  /// Brand accent as #rrggbb, inherited by all this developer's developments.
  brandColor        String?
  /// Curated font pairing key, inherited unless a development overrides it.
  brandFont         String?
  /// Default mini-site template, inherited unless a development overrides it.
  templateKey       String?

  properties        Property[]
  rentListings      RentListing[]
  listingFeeRuns    ListingFeeRun[]
  agentPartnerships AgentPartnership[]
}

/// A letting/sales agent — either a registered company or an individual
/// practitioner. Mirrors DeveloperProfile deliberately: same KYB lifecycle,
/// same public-contact fields, same monthly listing fee, so admin review and
/// billing work the same way for both and neither needs its own concepts.
model AgentProfile {
  id                String     @id @default(cuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              AgentKind

  /// Trading name. The company name, or the individual's professional name.
  displayName       String
  /// Company registration number — companies only.
  registrationNumber String?
  logoUrl           String?
  /// Passport-style photo. Required for individuals, who are the product;
  /// optional for companies, which lead with a logo.
  photoUrl          String?
  bio               String?
  yearsExperience   Int?
  website           String?

  /// Which of APARTMENT_RENTAL, VILLA_PURCHASE… this agent takes on. Drives
  /// the browse-page picker, so an empty list means they surface nowhere.
  specialties       AgentSpecialty[]
  /// Areas worked, free text — "Kilimani", "Westlands". Agents cover
  /// neighbourhoods rather than one fixed location.
  serviceAreas      String[]

  /// Same lifecycle as a developer's: nothing is publicly listed until an
  /// admin approves the documents.
  kybStatus         KybStatus  @default(NOT_SUBMITTED)
  /// Submitted documents as [{ type, url, label }] — company registration and
  /// physical-address proof, or national ID for an individual.
  kybDocuments      Json?
  kybReviewedAt     DateTime?
  kybReviewedBy     String?
  kybRejectionReason String?

  /// Public contact. Separate from User.phone, which is the private login
  /// contact for the account owner.
  phone             String?
  /// wa.me-ready digits, no plus — the WhatsApp button deep-links directly.
  whatsapp          String?
  email             String?
  /// Street address. Companies must give a physical location as part of KYC.
  officeAddress     String?
  location          String?
  socials           Json?

  /// Cached from AgentReview so the directory can sort by rating without
  /// aggregating on every request. Recomputed whenever a review lands.
  ratingAverage     Float      @default(0)
  ratingCount       Int        @default(0)

  /// Hidden from the public directory when the monthly fee goes unpaid past
  /// its grace period. Distinct from kybStatus: the agent is still verified,
  /// just not currently listed, and reactivates on payment.
  isListed          Boolean    @default(false)
  /// Set when non-payment hid the profile, so the UI can explain why.
  suspendedAt       DateTime?

  /// Leads this agent introduced. These are what a partnership is measured
  /// on — without them neither side can see what the relationship produced.
  attributedInquiries    Inquiry[]
  attributedBookings     Booking[]
  attributedReservations Reservation[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  reviews           AgentReview[]
  conversations     Conversation[]
  partnerships      AgentPartnership[]
  feeRuns           AgentFeeRun[]

  @@index([kybStatus])
  @@index([kind])
  @@index([isListed])
}

/// Where a partnership request stands. A developer and an agent both have to
/// want the relationship, so it is proposed by one side and accepted by the
/// other rather than imposed.
enum PartnershipStatus {
  PENDING
  ACTIVE
  DECLINED
  ENDED
}

/// A working relationship between a developer and an agent.
///
/// Partners appear on each other's public pages, and only an ACTIVE partner
/// can be assigned properties — the partnership is the gate that stops a
/// developer handing listings to an agent who never agreed to sell them.
model AgentPartnership {
  id           String            @id @default(cuid())
  developerId  String
  developer    DeveloperProfile  @relation(fields: [developerId], references: [id], onDelete: Cascade)
  agentId      String
  agent        AgentProfile      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status       PartnershipStatus @default(PENDING)

  /// Which side proposed it — either may, and the other accepts.
  requestedById String
  requestedBy   User             @relation("PartnershipRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  message       String?

  /// Default commission for work under this partnership, as a percentage.
  /// Individual assignments may override it.
  commissionPercent Float?
  respondedAt  DateTime?
  endedAt      DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignments  PropertyAssignment[]
  documents    PartnershipDocument[]

  /// One partnership per pair — re-requesting reuses the row rather than
  /// stacking duplicates that would each need answering.
  @@unique([developerId, agentId])
  @@index([status])
  @@index([agentId])
}

/// A property a developer has handed to an agent to sell or let, with the
/// commission agreed for it.
model PropertyAssignment {
  id            String            @id @default(cuid())
  partnershipId String
  partnership   AgentPartnership  @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Overrides the partnership default when the two differ — a flagship unit
  /// may be worth different terms from the rest of the portfolio.
  commissionPercent Float?
  notes         String?
  isActive      Boolean           @default(true)
  assignedAt    DateTime          @default(now())
  endedAt       DateTime?

  /// A property is assigned to a given partnership once; ending and
  /// reassigning reuses the row so its history is not lost.
  @@unique([partnershipId, propertyId])
  @@index([propertyId])
  @@index([isActive])
}

/// A signed agreement covering a partnership. Both parties can read every
/// document on their own partnership at any time, whichever side uploaded it.
model PartnershipDocument {
  id            String           @id @default(cuid())
  partnershipId String
  partnership   AgentPartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User             @relation("PartnershipDocUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  name          String
  url           String
  /// Free text — "Commission agreement", "Addendum", "Exclusivity terms".
  kind          String?
  sizeBytes     Int?
  createdAt     DateTime         @default(now())

  @@index([partnershipId])
}

/// One month's listing fee for one agent.
///
/// Mirrors ListingFeeRun rather than extending it: an agent's fee is a flat
/// monthly charge that differs by kind (a company pays more than a sole
/// practitioner), whereas a developer's scales with how many developments are
/// live. Sharing one table would mean a listingCount column that means
/// nothing for half the rows.
model AgentFeeRun {
  id           String              @id @default(cuid())
  agentId      String
  agent        AgentProfile        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Billing period as YYYY-MM.
  period       String
  /// Charged amount in major units, tax included.
  amount       Float
  currency     String              @default("KES")
  status       ListingFeeRunStatus @default(PENDING)
  reference    String?             @unique
  paymentId    String?
  failureText  String?
  attempts     Int                 @default(0)
  chargedAt    DateTime?
  /// When an unpaid fee stops being tolerated and the profile is hidden.
  /// Nothing is delisted before this, so one failed charge never silently
  /// removes a paying agent from the directory.
  graceEndsAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  /// One run per agent per month — reruns update rather than duplicate.
  @@unique([agentId, period])
  @@index([status])
}

/// A rating left on an agent. Only someone who actually dealt with the agent
/// may leave one — the service checks for a conversation or an assignment
/// first — because these scores decide who appears at the top of the picker.
model AgentReview {
  id        String       @id @default(cuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// 1–5. Enforced in the service; Prisma has no check constraint.
  rating    Int
  comment   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  /// One review per person per agent — editing replaces rather than stacks.
  @@unique([agentId, authorId])
  @@index([agentId])
}

// ─────────────────────────────────────────────
// PROPERTY
// ─────────────────────────────────────────────

model Property {
  id                  String            @id @default(cuid())
  slug                String            @unique
  name                String
  tagline             String?
  description         String?
  category            PropertyCategory  @default(APARTMENT)
  status              PropertyStatus    @default(DRAFT)
  developerId         String
  developer           DeveloperProfile  @relation(fields: [developerId], references: [id])
  addressLine         String?
  neighborhood        String?
  city                String            @default("Nairobi")
  county              String?
  country             String            @default("Kenya")
  latitude            Float?
  longitude           Float?
  heroImageUrl        String?
  heroVideoUrl        String?
  priceFrom           Float?
  priceTo             Float?
  currency            String            @default("KES")
  hasCinematicTour    Boolean           @default(false)
  has3DTour           Boolean           @default(false)
  hasVRTour           Boolean           @default(false)
  isFeatured          Boolean           @default(false)
  tags                String[]
  /// On-site facilities the development itself has — pool, gym, borehole,
  /// backup generator, 24/7 guards. Distinct from the `amenities` relation
  /// below, which holds nearby landmarks the development does NOT own
  /// (schools, hospitals, malls) and carries a distance to each.
  features            String[]
  completionDate      DateTime?
  submissionData      Json?

  // ─── Mini-site branding ──────────────────────────────────────────────────
  //
  // The public page is the developer's own sales site, shared directly with
  // their buyers, so it carries their identity rather than ours. Every field
  // here is nullable and falls back to the developer's defaults, so a
  // development inherits a coherent look without anyone configuring it.

  /// Brand accent as #rrggbb. Tints are derived at render, so one colour in
  /// yields a whole palette — a developer cannot produce an unreadable theme.
  brandColor          String?
  /// Curated pairing key (see BRAND_FONTS). Deliberately not free-form: one
  /// bad font would undermine a tour the developer paid six figures for.
  brandFont           String?
  /// Mini-site template key (see MINI_SITE_TEMPLATES). Decides the page shell —
  /// navbar, hero, section chrome — not the sections themselves, which are
  /// shared so every development gets the same functionality whatever it picks.
  templateKey         String?
  /// Opening treatment — full-bleed video, split, or cinematic.
  heroStyle           String?
  /// Section ids in display order. Empty means the default order.
  sectionOrder        String[]
  /// Section ids to omit entirely for this development.
  hiddenSections      String[]
  /// Primary call to action — "Book a viewing", "Request price list"…
  ctaLabel            String?
  /// SOLID or FLOATING — whether the navbar is pinned flush or floats clear.
  navbarStyle         String?
  /// LIGHT, DARK or BRAND. Foreground text is derived, never chosen, so a
  /// dark bar cannot end up carrying dark text.
  navbarTheme         String?
  /// Whether the hero keeps its gradient overlay. Defaults true: the overlay
  /// is what keeps the overlaid status chips legible, so turning it off is a
  /// deliberate choice for renders that do not need it.
  heroOverlay         Boolean           @default(true)
  /// Vanity host, e.g. "tours.developer.co.ke". Unique because it routes.
  customDomain        String?           @unique
  /// Hide e-resi attribution entirely. Top-tier only — the free tier keeps a
  /// small "Tours by e-resi" mark, which is what stops the mini-site being a
  /// standalone microsite a developer could just take elsewhere.
  whiteLabel          Boolean           @default(false)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  units               Unit[]
  agentAssignments    PropertyAssignment[]
  floorPlans          FloorPlan[]
  amenities           Amenity[]
  constructionUpdates ConstructionUpdate[]
  media               MediaAsset[]
  cinematicScenes     CinematicScene[]
  tourSections3D      TourSection3D[]
  tourScenesVR        TourSceneVR[]
  rentListings        RentListing[]
  savedBy             SavedProperty[]
  inquiries           Inquiry[]
  bookings            Booking[]
  invoices            Invoice[]
  productionOrders    ProductionOrder[]
  analyticsEvents     AnalyticsEvent[]
  productionTier      ProductionTier?

  conversations Conversation[]

  @@index([slug])
  @@index([status])
  @@index([developerId])
  @@index([city])
  @@index([isFeatured])
  /// Approval workflow — why a listing was rejected, and by whom.
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?
}

// ─────────────────────────────────────────────
// UNIT
// ─────────────────────────────────────────────

model Unit {
  id           String     @id @default(cuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  floor        Int?
  bedrooms     Int        @default(1)
  bathrooms    Int        @default(1)
  sqm          Float?
  price        Float
  currency     String     @default("KES")
  status       UnitStatus @default(AVAILABLE)
  floorPlanId  String?
  features     String[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reservations Reservation[]
  rentUnits    RentUnit[]

  @@index([propertyId])
  @@index([status])
}

// ─────────────────────────────────────────────
// RENT LISTING
// ─────────────────────────────────────────────

model RentListing {
  id                        String            @id @default(cuid())
  slug                      String            @unique
  propertyId                String
  property                  Property          @relation(fields: [propertyId], references: [id])
  developerId               String
  developer                 DeveloperProfile  @relation(fields: [developerId], references: [id])
  name                      String
  tagline                   String?
  description               String?
  status                    RentListingStatus @default(AVAILABLE)
  furnishing                FurnishingType    @default(UNFURNISHED)
  neighborhood              String?
  city                      String            @default("Nairobi")
  county                    String?
  country                   String            @default("Kenya")
  latitude                  Float?
  longitude                 Float?
  heroImageUrl              String?
  priceFrom                 Float?
  priceTo                   Float?
  currency                  String            @default("KES")
  availableFrom             DateTime?
  minLeaseTerm              Int               @default(12)
  show3DTour                Boolean           @default(false)
  showCinematicTour         Boolean           @default(false)
  featuredCinematicSceneIds String[]
  isFeatured                Boolean           @default(false)
  tags                      String[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  rentUnits                 RentUnit[]
  media                     MediaAsset[]
  inquiries                 Inquiry[]

  conversations Conversation[]

  @@index([slug])
  @@index([status])
  @@index([developerId])
  @@index([city])
}

// ─────────────────────────────────────────────
// RENT UNIT
// ─────────────────────────────────────────────

model RentUnit {
  id                String         @id @default(cuid())
  rentListingId     String
  rentListing       RentListing    @relation(fields: [rentListingId], references: [id], onDelete: Cascade)
  /** The physical unit this offer refers to, when one exists — lets a tenant reserve it. */
  unitId            String?
  unit              Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  label             String
  /** Layout being let: "Studio", "2 Bedroom", "Penthouse". */
  unitType          String?
  floor             Int?
  bedrooms          Int            @default(1)
  bathrooms         Int            @default(1)
  sqm               Float?
  pricePerMonth     Float
  currency          String         @default("KES")
  available         Int            @default(0)
  total             Int            @default(1)
  furnishing        FurnishingType @default(UNFURNISHED)
  features          String[]
  cinematicSceneIds String[]
  /** Which of the property's tours to show for this unit type. */
  showCinematicTour Boolean        @default(false)
  show3DTour        Boolean        @default(false)
  showVRTour        Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([rentListingId])
  @@index([unitId])
}

// ─────────────────────────────────────────────
// MEDIA ASSET
// ─────────────────────────────────────────────

model MediaAsset {
  id              String       @id @default(cuid())
  type            MediaType
  url             String
  thumbnailUrl    String?
  title           String?
  order           Int          @default(0)
  isFeatured      Boolean      @default(false)
  sizeBytes       Int?
  mimeType        String?
  propertyId      String?
  property        Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentListingId   String?
