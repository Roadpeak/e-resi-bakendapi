// ─────────────────────────────────────────────
// INQUIRY
// ─────────────────────────────────────────────

model Inquiry {
  id              String        @id @default(cuid())
  propertyId      String?
  property        Property?     @relation(fields: [propertyId], references: [id])
  rentListingId   String?
  rentListing     RentListing?  @relation(fields: [rentListingId], references: [id])
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  name            String
  email           String
  phone           String?
  message         String
  interestedUnit  String?
  status          InquiryStatus @default(NEW)
  /// The agent who introduced this lead, when one did.
  agentId         String?
  agent           AgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /// Set when a reply turned this lead into a chat thread, so the inbox can
  /// point at the conversation instead of dead-ending in email.
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  replies         InquiryReply[]

  @@index([propertyId])
  @@index([rentListingId])
  @@index([userId])
  @@index([status])
}

