// ─────────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────────

/// A conversation between a customer (investor/tenant/buyer) and a developer,
/// anchored to the property or rent listing it started from.
/// A two-party conversation.
///
/// Originally hardcoded customer-to-developer. Agents talk to tenants,
/// investors AND developers, so the parties are now neutral: `initiator`
/// started it, `counterparty` was contacted. Roles live on the User, not in
/// these column names, so a new participant type needs no schema change.
model Conversation {
  id             String    @id @default(cuid())
  initiatorId    String
  initiator      User      @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  counterpartyId String
  counterparty   User      @relation("ConversationCounterparty", fields: [counterpartyId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  rentListingId  String?
  rentListing    RentListing? @relation(fields: [rentListingId], references: [id], onDelete: SetNull)
  /// Set when the conversation is about an agent rather than a listing, so an
  /// enquiry to an agent has context the way a property enquiry does.
  agentId        String?
  agent          AgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  subject        String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  messages       ChatMessage[]

  /// One thread per pair per context — re-contacting about the same listing
  /// continues the thread rather than starting a second one.
  ///
  /// Named explicitly: the generated name would exceed Postgres' 63-character
  /// identifier limit and be truncated, which makes it hard to reference
  /// reliably from later migrations.
  @@unique([initiatorId, counterpartyId, propertyId, rentListingId, agentId], map: "Conversation_parties_context_key")
  @@index([initiatorId])
  @@index([counterpartyId])
  @@index([lastMessageAt])
  /// Inquiries that were converted into this thread.
  inquiries      Inquiry[]
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

/// Every administrative mutation, recorded for accountability. A console that
/// can change prices, suspend users and delete properties must be traceable.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  /// Dotted verb, e.g. "user.suspend", "pricing.tier.update".
  action     String
  /// Model name of the affected record, e.g. "Property".
  targetType String?
  targetId   String?
  /// Human-readable summary shown in the activity feed.
  summary    String?
  /// Field-level before/after for the change.
  changes    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// PRICING (admin-managed)
// ─────────────────────────────────────────────

/// Price of a production tier. Replaces the hardcoded TIER_PRICING map so
/// admins can change pricing without a deploy. One row per tier.
model PricingPlan {
  id          String             @id @default(cuid())
  tier        ProductionTierType @unique
  /// Display name shown to developers, e.g. "Cinematic Tour".
  label       String
  price       Float
  currency    String             @default("KES")
  features    String[]
  description String?
  isActive    Boolean            @default(true)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive])
}

enum ServiceCategoryType {
  CAPTURE
  IMMERSIVE
  MARKETING
  DESIGN
}

/// An à-la-carte production service a developer can order during onboarding.
/// Replaces the hardcoded SERVICES array in the frontend catalog.
model ServiceCatalogItem {
  id          String              @id @default(cuid())
  /// Stable key referenced by existing submissionData, e.g. "drone_photo".
  key         String              @unique
  label       String
  category    ServiceCategoryType
  /// Default price, used for any property type without an explicit override.
  price       Float
  currency    String              @default("USD")
  unit        String?
  description String?
  isActive    Boolean             @default(true)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  priceOverrides ServicePriceOverride[]

  @@index([category])
  @@index([isActive])
}

/// Per-property-type price for a production service. Shooting a villa costs
/// more than a one-bed apartment, so each service can be priced separately by
/// PropertyCategory.
///
/// Modelled as overrides rather than duplicating catalog rows per type: the
/// catalog `key` is unique and is referenced by past orders and submissionData,
/// so it cannot be forked per type without breaking those references. A missing
/// row here means "use the catalog's default price", which is also what keeps
/// existing installs working unchanged until an admin sets a type price.
model ServicePriceOverride {
  id            String             @id @default(cuid())
  serviceId     String
  service       ServiceCatalogItem @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  propertyType  PropertyCategory
  price         Float
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([serviceId, propertyType])
  @@index([propertyType])
}

/// Key/value platform configuration — listing fee, currency, tax rate,
/// feature flags. Typed by `valueType` so the admin UI can render an
/// appropriate control.
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  valueType   String   @default("string")
  label       String
  description String?
  group       String   @default("general")
  updatedAt   DateTime @updatedAt

  @@index([group])
}

// ─────────────────────────────────────────────
// RECURRING LISTING-FEE BILLING
// ─────────────────────────────────────────────

/// One row per developer per billing period. The unique constraint on
/// (developerId, period) is what makes the monthly run idempotent — a retry,
/// an overlapping run or a manual re-trigger can never double-charge.
model ListingFeeRun {
  id           String              @id @default(cuid())
  developerId  String
  developer    DeveloperProfile    @relation(fields: [developerId], references: [id], onDelete: Cascade)
  /// Billing period as YYYY-MM, e.g. "2026-08".
  period       String
  /// Number of live developments the fee was calculated over.
  listingCount Int
  /// Charged amount in major units (e.g. 4900.00 KES), tax included.
  amount       Float
  currency     String              @default("KES")
  status       ListingFeeRunStatus @default(PENDING)
  /// Paystack transaction reference, once a charge has been attempted.
  reference    String?             @unique
  paymentId    String?
  failureText  String?
  attempts     Int                 @default(0)
  chargedAt    DateTime?
  invoice      Invoice?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([developerId, period])
  @@index([status])
  @@index([period])
}

enum ListingFeeRunStatus {
  PENDING
  PAID
  FAILED
  /// Nothing to charge — no live listings, or still inside the free window.
  SKIPPED
}

// ─────────────────────────────────────────────
// INVOICING & RECEIPTS
// ─────────────────────────────────────────────

/// What an invoice is billing for. Drives the copy and the due-date rules.
enum InvoiceKind {
  /// Recurring monthly listing fee, issued 3 days before it falls due.
  SUBSCRIPTION
  /// One-off media production work, issued as soon as it is ordered.
  PRODUCTION
}

enum InvoiceStatus {
  DRAFT
  /// Sent to the customer and awaiting payment.
  ISSUED
  /// Past its due date.
  OVERDUE
  PAID
  CANCELLED
}

model Invoice {
  id          String        @id @default(cuid())
  /// Human-facing sequential reference, e.g. "INV-2026-000042".
  number      String        @unique
  kind        InvoiceKind
  status      InvoiceStatus @default(DRAFT)

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set for subscription invoices; ties the invoice to its billing run.
  listingFeeRunId String?   @unique
  listingFeeRun   ListingFeeRun? @relation(fields: [listingFeeRunId], references: [id], onDelete: SetNull)
  /// Set for production invoices.
  propertyId  String?
  property    Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// Snapshot of the biller and customer at issue time — an invoice must not
  /// change retroactively when a company renames itself.
  billedToName  String
  billedToEmail String

  /// Line items as [{ description, quantity, unitAmount, amount }].
  lineItems   Json
  subtotal    Float
  taxPercent  Float         @default(0)
  taxAmount   Float         @default(0)
  total       Float
  currency    String        @default("KES")

  issuedAt    DateTime?
  dueAt       DateTime
  paidAt      DateTime?
  /// When the account is suspended if this stays unpaid. Set when a reminder
  /// carrying a termination warning goes out.
  terminatesAt DateTime?

  /// How many reminders have been sent, and when the last one went.
  remindersSent Int         @default(0)
  lastReminderAt DateTime?

  paymentId   String?
  notes       String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  receipt     Receipt?

  @@index([userId])
  @@index([status])
  @@index([dueAt])
}

/// Issued once an invoice is settled. Separate from Invoice so a receipt
/// number is never reused and the paid snapshot cannot drift.
model Receipt {
  id          String   @id @default(cuid())
  number      String   @unique
  invoiceId   String   @unique
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("KES")
  method      String
  reference   String?
  paidAt      DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// PRODUCTION ORDERS (per service)
// ─────────────────────────────────────────────

/// One ordered production service for one development.
///
/// Deliberately per-service rather than per-property: a developer buying
/// photography and a cinematic tour is buying two jobs that get scheduled on
/// different days by different crews, and are invoiced as separate lines.
/// ProductionTier keeps modelling the packaged tier a listing sits on; this
/// models the work actually owed.
model ProductionOrder {
  id          String                @id @default(cuid())
  propertyId  String
  property    Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Catalog key, e.g. "photography". Matches ServiceCatalogItem.key when the
  /// service is still in the catalog; kept as a plain string so an order
  /// survives the catalog entry being renamed or retired.
  serviceKey  String
  label       String
  amount      Float
  currency    String                @default("KES")
  status      ProductionOrderStatus @default(ORDERED)

  /// What the developer asked for at order time.
  preferredDate String?
  instructions  String?
  accessInfo    String?

  /// Set by ops once a crew is booked.
  scheduledAt DateTime?
  deliveredAt DateTime?
  crewNotes   String?

  /// The invoice line this was billed on, if it has been billed at all.
  invoiceId   String?

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([propertyId, serviceKey])
  @@index([status])
  @@index([propertyId])
}
